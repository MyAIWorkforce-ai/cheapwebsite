# =========================================
# Skillzy — environment variables
# Copy to .env.local (never commit). On Vercel,
# add each one under Project → Settings → Env.
# Missing keys make the affected feature
# gracefully fall back to demo mode.
# =========================================

# --- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth, database, file storage)
# https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments + Connect creator payouts)
# https://dashboard.stripe.com/test/apikeys
# Webhook: register https://<your-domain>/api/webhooks/stripe
#   events: checkout.session.completed, account.updated, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (transactional email — purchase confirmation, etc.)
# https://resend.com → API Keys
# Sender domain must be verified before EMAIL_FROM can send.
RESEND_API_KEY=
EMAIL_FROM=hi@skillzy.ai

# --- OAuth providers (configured INSIDE Supabase, not here)
# Set up in Supabase Dashboard → Authentication → Providers.
# Skillzy itself never reads these values; they live in Supabase.
# Redirect URI for both Google + GitHub is:
#   https://<your-supabase-url>/auth/v1/callback
